;; Facet conformance test: filesystem/preopen-root
;; Purpose: The WASI-compatible root manifest exposes one preopen whose display name can be read directly as `/`.
;; Required profiles: core, memory32, filesystem
;;
;; SPDX-License-Identifier: MIT

(module
  (type $a8 (array (mut i8)))
  (type $a16 (array (mut i16)))
  (type $a32 (array (mut i32)))

  (import "facet" "fs_preopen_count" (func $count (result i32 i32)))
  (import "facet" "fs_preopen_get" (func $get (param i32) (result i32 i32)))
  (import "facet" "fs_preopen_name_len_i8" (func $len8 (param i32 i32) (result i64 i32)))
  (import "facet" "fs_preopen_name_len_i16" (func $len16 (param i32 i32) (result i64 i32)))
  (import "facet" "fs_preopen_name_len_i32" (func $len32 (param i32 i32) (result i64 i32)))
  (import "facet" "fs_preopen_name_read_mem32_i8" (func $read_mem32_i8 (param i32 i32 i32 i32 i32) (result i64 i32)))
  (import "facet" "fs_preopen_name_read_mem32_i16" (func $read_mem32_i16 (param i32 i32 i32 i32 i32) (result i64 i32)))
  (import "facet" "fs_preopen_name_read_mem32_i32" (func $read_mem32_i32 (param i32 i32 i32 i32 i32) (result i64 i32)))
  (import "facet" "fs_preopen_name_read_mem64_i8" (func $read_mem64_i8 (param i32 i32 i32 i64 i64) (result i64 i32)))
  (import "facet" "fs_preopen_name_read_mem64_i16" (func $read_mem64_i16 (param i32 i32 i32 i64 i64) (result i64 i32)))
  (import "facet" "fs_preopen_name_read_mem64_i32" (func $read_mem64_i32 (param i32 i32 i32 i64 i64) (result i64 i32)))
  (import "facet" "fs_preopen_name_read_into_array_i8" (func $read_into_i8 (param i32 i32 (ref array) i32 i32) (result i64 i32)))
  (import "facet" "fs_preopen_name_read_into_array_i16" (func $read_into_i16 (param i32 i32 (ref array) i32 i32) (result i64 i32)))
  (import "facet" "fs_preopen_name_read_into_array_i32" (func $read_into_i32 (param i32 i32 (ref array) i32 i32) (result i64 i32)))
  (import "facet" "fs_preopen_name_read_array_i8" (func $read_array_i8 (param i32 i32) (result (ref null $a8) i32)))
  (import "facet" "fs_preopen_name_read_array_i16" (func $read_array_i16 (param i32 i32) (result (ref null $a16) i32)))
  (import "facet" "fs_preopen_name_read_array_i32" (func $read_array_i32 (param i32 i32) (result (ref null $a32) i32)))

  (memory 1)
  (memory i64 1)

  (func (export "run") (result i32)
    (local $count i32)
    (local $dir i32)
    (local $e i32)
    (local $n i64)
    (local $a8 (ref $a8))
    (local $a16 (ref $a16))
    (local $a32 (ref $a32))
    (local $out8 (ref null $a8))
    (local $out16 (ref null $a16))
    (local $out32 (ref null $a32))

    (call $count) (local.set $e) (local.set $count)
    (if (i32.or (local.get $e) (i32.ne (local.get $count) (i32.const 1)))
      (then (return (i32.const 10))))
    (call $get (i32.const 0)) (local.set $e) (local.set $dir)
    (if (local.get $e) (then (return (i32.const 11))))

    ;; `/` is one code unit in every supported text representation.
    (call $len8 (i32.const 0) (i32.const 0)) (local.set $e) (local.set $n)
    (if (i32.or (local.get $e) (i64.ne (local.get $n) (i64.const 1)))
      (then (return (i32.const 12))))
    (call $len16 (i32.const 0) (i32.const 0)) (local.set $e) (local.set $n)
    (if (i32.or (local.get $e) (i64.ne (local.get $n) (i64.const 1)))
      (then (return (i32.const 13))))
    (call $len32 (i32.const 0) (i32.const 0)) (local.set $e) (local.set $n)
    (if (i32.or (local.get $e) (i64.ne (local.get $n) (i64.const 1)))
      (then (return (i32.const 14))))

    (call $read_mem32_i8 (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 1))
    (local.set $e) (local.set $n)
    (if (i32.or (local.get $e)
          (i32.or (i64.ne (local.get $n) (i64.const 1))
                  (i32.ne (i32.load8_u (i32.const 0)) (i32.const 47))))
      (then (return (i32.const 15))))
    (call $read_mem32_i16 (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 16) (i32.const 1))
    (local.set $e) (local.set $n)
    (if (i32.or (local.get $e)
          (i32.or (i64.ne (local.get $n) (i64.const 1))
                  (i32.ne (i32.load16_u (i32.const 16)) (i32.const 47))))
      (then (return (i32.const 16))))
    (call $read_mem32_i32 (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 32) (i32.const 1))
    (local.set $e) (local.set $n)
    (if (i32.or (local.get $e)
          (i32.or (i64.ne (local.get $n) (i64.const 1))
                  (i32.ne (i32.load (i32.const 32)) (i32.const 47))))
      (then (return (i32.const 17))))

    (call $read_mem64_i8 (i32.const 0) (i32.const 0) (i32.const 1) (i64.const 0) (i64.const 1))
    (local.set $e) (local.set $n)
    (if (i32.or (local.get $e) (i64.ne (local.get $n) (i64.const 1)))
      (then (return (i32.const 18))))
    (call $read_mem64_i16 (i32.const 0) (i32.const 0) (i32.const 1) (i64.const 16) (i64.const 1))
    (local.set $e) (local.set $n)
    (if (i32.or (local.get $e) (i64.ne (local.get $n) (i64.const 1)))
      (then (return (i32.const 19))))
    (call $read_mem64_i32 (i32.const 0) (i32.const 0) (i32.const 1) (i64.const 32) (i64.const 1))
    (local.set $e) (local.set $n)
    (if (i32.or (local.get $e) (i64.ne (local.get $n) (i64.const 1)))
      (then (return (i32.const 20))))

    (local.set $a8 (array.new_default $a8 (i32.const 1)))
    (local.set $a16 (array.new_default $a16 (i32.const 1)))
    (local.set $a32 (array.new_default $a32 (i32.const 1)))
    (call $read_into_i8 (i32.const 0) (i32.const 0) (local.get $a8) (i32.const 0) (i32.const 1))
    (local.set $e) (local.set $n)
    (if (i32.or (local.get $e) (i32.ne (array.get_u $a8 (local.get $a8) (i32.const 0)) (i32.const 47)))
      (then (return (i32.const 21))))
    (call $read_into_i16 (i32.const 0) (i32.const 0) (local.get $a16) (i32.const 0) (i32.const 1))
    (local.set $e) (local.set $n)
    (if (i32.or (local.get $e) (i32.ne (array.get_u $a16 (local.get $a16) (i32.const 0)) (i32.const 47)))
      (then (return (i32.const 22))))
    (call $read_into_i32 (i32.const 0) (i32.const 0) (local.get $a32) (i32.const 0) (i32.const 1))
    (local.set $e) (local.set $n)
    (if (i32.or (local.get $e) (i32.ne (array.get $a32 (local.get $a32) (i32.const 0)) (i32.const 47)))
      (then (return (i32.const 23))))

    (call $read_array_i8 (i32.const 0) (i32.const 0)) (local.set $e) (local.set $out8)
    (if (i32.or (local.get $e) (ref.is_null (local.get $out8)))
      (then (return (i32.const 24))))
    (call $read_array_i16 (i32.const 0) (i32.const 0)) (local.set $e) (local.set $out16)
    (if (i32.or (local.get $e) (ref.is_null (local.get $out16)))
      (then (return (i32.const 25))))
    (call $read_array_i32 (i32.const 0) (i32.const 0)) (local.set $e) (local.set $out32)
    (if (i32.or (local.get $e) (ref.is_null (local.get $out32)))
      (then (return (i32.const 26))))

    (i32.const 0))
)
(assert_return (invoke "run") (i32.const 0))
